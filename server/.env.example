# Copy to server/.env and fill in. .env is git-ignored, never commit real keys.
# On Render: Dashboard → your service → Environment.

# Required: OpenWeather API key (https://home.openweathermap.org/api_keys)
OPENWEATHER_KEY=

# Optional: WAQI token for ground-station air quality (https://aqicn.org/data-platform/token/)
# Without it, air quality comes from Open-Meteo (no key needed).
WAQI_KEY=

# Optional: extra websites allowed to call the API, comma-separated
# (atmoscheck.vercel.app, its previews and localhost are always allowed)
# ALLOWED_ORIGINS=https://my-other-domain.com

# Set automatically by Render
# PORT=5050
